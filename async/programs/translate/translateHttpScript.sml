(*
  The bodies HTTP server with the GENERATED proto handler
  (translateProto) meets HttpSpec' whole specification:

     http_gpb_prog_spec : http_spec 3w demo_files http_gpb_prog

  The parser and responder are the chain's translations (httpProg:
  b_parse, bresp_demo); the server (gproto_server), main and the program
  boilerplate are generated by translateGlueLib.
*)
Theory translateHttp
Ancestors
  asyncCore asyncLevel1 libModel libProg loopPollWorld loopPollProg loopPoll
  loopRounds loopPollDyn echoSockModel libSockApprox echoSockServer skeleton
  socketWorld socketProof socketDiv divMain EchoSpec HttpGetSpec
  HttpHeadersSpec HttpSpec protoInterface protoServer protoSockSpec
  protoMain protoProg httpProto httpProg cfDiv ml_translator ml_prog
  std_prelude llist httpSemantics translateSock translateProto
  translateProtoGlue skeletonUses skeletonRunOk protoSockModel protoSafe
  protoLive echoSafeHeadline
Libs
  preamble basis cfDivLib cfTacticsLib ml_progLib basisFunctionsLib
  translateGlueLib

val _ = translation_extends "translateProtoGlue"

(* main and the whole program, generated (translateGlueLib) *)
val main_gpb_spec = translate_main {
  name = "main", server_call = "gproto_server b_parse bresp_demo 3",
  goal = ‘limited_parts socket_names p ∧
          s0.listeners = [(3w, [])] ∧ s0.conns = [] ∧ UNIT_TYPE () uv ⇒
          app (p:'ffi ffi_proj) translateHttp$main_v [uv] (SOCKETS_EV s0 [])
            (POSTd io. io = proto_trace P_b resp_b s0)’,
  server_post = ‘POSTv cv. &COMP p SACT UNIT_TYPE SSNAP
                             (srelabel (proto_server P_b resp_b 3)) cv *
                           SOCKETS_EV s0 []’,
  server_tac = (xapp_spec (INST_TYPE (map (fn ty => ty |-> “:brequest”)
                  (filter (fn ty => ty <> “:'ffi”)
                     (type_vars_in_term (concl gproto_server_spec))))
                  gproto_server_spec) >> xsimpl >>
                qexistsl [‘resp_b’, ‘P_b’, ‘HTTPSPEC_BREQUEST_TYPE’] >> simp [] >>
                irule proto_impl_b >>
                mp_tac (fetch "httpProg" "bresp_demo_v_thm") >>
                simp [bresp_demo_eq]),
  run_ok_tac = (simp [wf_sproto_server, LIST_TYPE_def] >> conj_tac
                >- (irule gen_grun_ok >> simp [] >> qexists_tac ‘3’ >>
                    simp [uses_ok_def, proto_server_uses_accepted, proto_ok_b]) >>
                metis_tac [])}

val gpb = translate_program {
  prefix = "http_gpb", main_v = lhs (concl (fetch "-" "main_v_def")),
  main_spec = main_gpb_spec,
  trace = “λs0. proto_trace P_b resp_b s0”,
  hyps = “λs0:sockets. s0.listeners = [(3w, [])] ∧ s0.conns = []”}

(* MAIN: the bodies HTTP program whose handler, server and main were
   generated meets the trusted HTTP specification *)
Theorem http_gpb_prog_spec:
  http_spec 3w demo_files http_gpb_prog
Proof
  simp[http_spec_proto] >> irule proto_spec_of_semantics >>
  simp[proto_ok_b, #semantics_prog gpb]
QED
