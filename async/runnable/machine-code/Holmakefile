           ../../servers/echo \
           ../../servers/relabel \
           ../../spec \
           ../../world/clock \
           ../../world/composed \
           ../../world/sockets \
           ../../world/sockets-cf \
           $(CAKEMLDIR)/semantics \
           $(CAKEMLDIR)/cv_translator \
           $(CAKEMLDIR)/compiler/backend/proofs \
           $(CAKEMLDIR)/compiler/backend/arm8/proofs \
           $(CAKEMLDIR)/semantics/proofs
