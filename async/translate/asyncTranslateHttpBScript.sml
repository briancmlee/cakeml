(*
  The bodies HTTP server with the GENERATED proto handler
  (asyncTranslateProto) meets HttpSpecBodies' whole specification:

     http_prog_gpb_spec : http_spec_b 3w demo_files http_prog_gpb

  The parser and responder are the chain's translations (asyncProtoProgB:
  b_parse, bresp_demo); main is gproto_main on them.  The rest is
  asyncProtoSemB's per-program boilerplate, for the new program.
*)
Theory asyncTranslateHttpB
Ancestors
  asyncCore asyncLevel1 asyncCfActModel asyncCfActProg asyncM3World
  asyncM3Prog asyncM3Loop asyncM4GRounds asyncM4Loop asyncM4SockModel
  asyncM4SockApprox asyncM4SockServer asyncServerWith
  ffiSpikeSocketFFI ffiSpikeSocketProof ffiSpikeSocketDiv ffiSpikeDivMain
  EchoSpec HttpSpec HttpSpecHeaders HttpSpecBodies asyncHttpMain asyncHeadline
  asyncProto asyncProtoServer asyncProtoSockSpec asyncProtoMain asyncProtoProg
  asyncProtoB asyncProtoProgB asyncProtoSemB asyncTranslateSock
  asyncTranslateProto asyncTranslateProtoGlue cfDiv ml_translator ml_prog std_prelude llist
Libs
  preamble basis cfDivLib cfTacticsLib ml_progLib basisFunctionsLib

val _ = translation_extends "asyncTranslateProtoGlue"

Quote add_cakeml:
  fun main u = gproto_main b_parse bresp_demo u;
End

(* MAIN (helper): main () is the generated server's main on the bodies
   protocol *)
Theorem main_gpb_spec:
  limited_parts socket_names p ∧
  s0.listeners = [(3w, [])] ∧ s0.conns = [] ∧ UNIT_TYPE () uv ⇒
  app (p:'ffi ffi_proj) asyncTranslateHttpB$main_v [uv] (SOCKETS_EV s0 [])
    (POSTd io. io = proto_trace P_b resp_b s0)
Proof
  rpt strip_tac >> xcf_with_def (fetch "-" "main_v_def") >>
  xapp_spec gproto_main_spec >> xsimpl >>
  simp[proto_ok_b] >> qexists_tac ‘HTTPSPECBODIES_BREQUEST_TYPE’ >>
  irule proto_impl_b >>
  mp_tac (fetch "asyncProtoProgB" "bresp_demo_v_thm") >> simp[bresp_demo_eq]
QED

(* ------------------------------------------------------------------------
   The whole program (asyncProtoSemB's boilerplate)
   ------------------------------------------------------------------------ *)

val http_decs_gpb_tm =
  get_ml_prog_state () |> ml_progLib.get_thm
  |> REWRITE_RULE [ml_progTheory.ML_code_def, ml_progTheory.ML_code_env_def]
  |> concl |> strip_comb |> snd |> (fn args => List.nth (args, 2));

Definition http_decs_gpb_def:
  http_decs_gpb = ^http_decs_gpb_tm
End

Definition http_prog_gpb_def:
  http_prog_gpb = SNOC (main_call «main») http_decs_gpb
End

Theorem http_prog_gpb_eq =
  REWRITE_CONV [http_prog_gpb_def, http_decs_gpb_def, main_call_def,
                listTheory.SNOC_APPEND, listTheory.APPEND] “http_prog_gpb”;

val Decls_th =
  get_ml_prog_state () |> ml_progLib.get_thm
  |> REWRITE_RULE [ml_progTheory.ML_code_def, ml_progTheory.ML_code_env_def]
  |> GEN_ALL |> ISPEC “socket_only_ffi s0” |> SPEC_ALL
  |> REWRITE_RULE [GSYM http_decs_gpb_def];

val (_, decls_args) = strip_comb (concl Decls_th);
val env2_tm = List.nth (decls_args, 3);
val st2_tm = List.nth (decls_args, 4);

val lookup_main = let
  val g = “nsLookup (^env2_tm).v (Short «main») = SOME asyncTranslateHttpB$main_v”
  in prove (g, REWRITE_TAC [fst (dest_eq g) |> nsLookup_conv]) end;

val st2_ffi = prove (“(^st2_tm).ffi = socket_only_ffi s0”, EVAL_TAC);

Theorem http_semantics_gpb[local]:
  s0.listeners = [(3w, [])] ∧ s0.conns = [] ⇒
  semantics_dec_list (init_state (socket_only_ffi s0)) init_env
    http_prog_gpb (Diverge (proto_trace P_b resp_b s0))
Proof
  strip_tac
  \\ assume_tac Decls_th
  \\ drule call_main_thm_div \\ strip_tac
  \\ assume_tac st2_ffi
  \\ drule sonly_init_heap \\ strip_tac
  \\ first_x_assum (qspecl_then [‘sonly_proj2’, ‘sonly_proj1’, ‘h2’, ‘h1’,
       ‘asyncTranslateHttpB$main_v’, ‘«main»’, ‘λio. io = proto_trace P_b resp_b s0’,
       ‘SOCKETS_EV s0 []’] mp_tac)
  \\ impl_tac
  >- (simp [lookup_var_def, lookup_main]
      \\ irule main_gpb_spec \\ simp [limited_parts_sonly])
  \\ rw [http_prog_gpb_def] \\ fs[]
QED

Theorem http_prog_gpb_syntax_ok:
  prog_syntax_ok http_prog_gpb
Proof
  REWRITE_TAC [http_prog_gpb_eq, prog_syntax_ok_def] >> EVAL_TAC
QED

Theorem http_semantics_prog_gpb:
  s0.listeners = [(3w, [])] ∧ s0.conns = [] ⇒
  semantics_prog (init_state (socket_only_ffi s0)) init_env http_prog_gpb
    (Diverge (proto_trace P_b resp_b s0))
Proof
  strip_tac >> drule http_semantics_gpb >>
  simp [GSYM (MATCH_MP prog_syntax_ok_semantics http_prog_gpb_syntax_ok)]
QED

(* MAIN: the bodies HTTP program whose handler was generated by the
   translator meets HttpSpecBodies' whole specification *)
Theorem http_prog_gpb_spec:
  http_spec_b 3w demo_files http_prog_gpb
Proof
  simp[http_spec_b_proto] >> irule proto_spec_of_semantics >>
  simp[proto_ok_b, http_semantics_prog_gpb]
QED
